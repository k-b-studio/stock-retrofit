# Settrade Open API credentials — market data only, never order placement.
# Copy to .env (which is gitignored) and fill in. Obtained from developer.settrade.com
# via a participating broker; a sandbox key is issued from the portal but historical
# depth under sandbox is UNVERIFIED — see docs/settrade-api-notes.md.
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_BROKER_ID=
# "sandbox" or "live" — selects the SDK environment.
SETTRADE_ENVIRONMENT=sandbox
